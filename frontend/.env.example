# Consilium frontend environment variables.
#
# Copy this file to .env.local for local development. On Vercel, set these
# in Project Settings -> Environment Variables (all three environments:
# Production, Preview, Development).
#
# Only NEXT_PUBLIC_* variables are exposed to the browser. Don't put
# secrets in here.

# Backend URL the frontend calls for /api/* routes.
# Local dev:  http://127.0.0.1:8787
# Production: https://consilium-api-s9gw.onrender.com
NEXT_PUBLIC_API_URL=https://consilium-api-s9gw.onrender.com

# --- SoSoValue ---
# Leave empty to run in MOCK mode (recommended for local dev/demo)
SOSO_API_KEY=
SOSO_BASE_URL=https://openapi.sosovalue.com/openapi/v1

# --- LLM (optional; falls back to deterministic reasoning strings) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- SoDEX (execution layer) ---
# Market data is unsigned and always works. Signed writes require the three
# SODEX_EVM_* values below. Use testnet for development; never put a mainnet
# private key in this file.
SODEX_NETWORK=testnet
SODEX_EVM_PRIVATE_KEY=
SODEX_EVM_ADDRESS=
SODEX_PERPS_ACCOUNT_ID=0
SODEX_API_KEY_NAME=sosofund

# --- App ---
APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./sosofund.db
CORS_ORIGINS=http://localhost:3000

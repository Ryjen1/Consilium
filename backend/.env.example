# --- SoSoValue ---
# Leave empty to run in MOCK mode (recommended for local dev/demo)
SOSO_API_KEY=
SOSO_BASE_URL=https://openapi.sosovalue.com/openapi/v1

# --- LLM (optional; falls back to deterministic reasoning strings) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App ---
APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./sosofund.db
CORS_ORIGINS=http://localhost:3000
